generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id         Int  @id @default(autoincrement())
  username   String @unique
  password String
  foto String 
  
  createdAt   DateTime  @default(now()) @map("created_at")
  @@map("users")

}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  location    String
  dateEvent   DateTime  @map("date_event")
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  categoryId  Int       @map("category_id")

  pembicaraId Int?      @map("pembicara_id")
  category    Category  @relation(fields: [categoryId], references: [id])
  pembicara   Pembicara? @relation(fields: [pembicaraId], references: [id])

  @@map("events")
}

model Category {
  id     Int     @id @default(autoincrement())
  nama   String
  events Event[]

  @@map("categories")
}

model Pembicara {
  id     Int     @id @default(autoincrement())
  name   String
  role   String
  email  String  @unique
  photo  String
  events Event[]  

  @@map("pembicara")
}